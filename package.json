{
  "name": "partner-order",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "build:sites": "npm run build && node scripts/build-sites-server.mjs",
    "catalogue:push": "powershell -ExecutionPolicy Bypass -File scripts/push-catalogue-update.ps1",
    "preview": "vite preview",
    "grant-admin": "node scripts/grant-admin.mjs",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "firebase-admin": "^13.10.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
